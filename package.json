{
  "name": "notes",
  "private": true,
  "version": "0.1.0",
  "description": "本地优先的桌面笔记应用：知识库 → 文档树 → Markdown 编辑",
  "author": "笔记",
  "type": "module",
  "main": "electron/main.cjs",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:electron\"",
    "dev:web": "vite",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 node electron/launch.cjs",
    "dev:electron:log": "wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 ELECTRON_ENABLE_LOGGING=true node electron/launch.cjs --enable-logging",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:rich-editor": "vite build && node scripts/rich-editor-check.mjs",
    "test:rich-editor:lossless": "vite build && node scripts/rich-editor-complex-doc.mjs",
    "build": "tsc -b && vite build",
    "build:analyze": "cross-env ANALYZE=1 npm run build",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run test:unit && npm run build",
    "verify:all": "npm run verify && npm run test:e2e",
    "preview": "vite preview",
    "start": "node electron/launch.cjs",
    "icons": "node scripts/build-icons.cjs",
    "dist:dir": "npm run build && cross-env ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --dir --publish never",
    "dist": "npm run build && cross-env ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --publish never"
  },
  "build": {
    "appId": "com.notes.desktop",
    "productName": "笔记",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/tray.png",
      "package.json"
    ],
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "笔记",
      "artifactName": "notes-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "notes-${version}-portable.${ext}"
    }
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "immer": "^11.1.8",
    "jsdom": "^29.1.1",
    "katex": "^0.18.4",
    "mermaid": "^11.17.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass": "^1.100.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.8",
    "wait-on": "^9.0.5",
    "zustand": "^5.0.12"
  }
}
